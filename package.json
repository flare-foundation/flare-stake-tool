{
  "name": "@flarenetwork/flare-stake-tool",
  "version": "5.0.0",
  "description": "Utilities for staking on the Flare network",
  "bin": {
    "flare-stake-tool": "bin/flare-stake-tool"
  },
  "scripts": {
    "tsc": "tsc",
    "build": "rimraf dist/ && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "mocha",
    "test:coverage": "c8 mocha",
    "test:integration": "mocha --config .mocharc.integration.yml",
    "test:record-fixtures": "tsx test/characterization/record.ts",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"eslint.config.mjs\"",
    "format:fix": "prettier --write \"{src,test}/**/*.ts\" \"eslint.config.mjs\"",
    "interactive": "bin/flare-stake-tool interactive"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flare-foundation/flare-stake-tool.git"
  },
  "keywords": [
    "Flare",
    "blockchain",
    "defi"
  ],
  "files": [
    "dist",
    "bin"
  ],
  "author": "Flare Networks",
  "homepage": "https://github.com/flare-foundation/flare-stake-tool#readme",
  "license": "MIT",
  "prettier": "@flarenetwork/prettier-config-flare",
  "dependencies": {
    "@avalabs/hw-app-avalanche": "^1.1.3",
    "@flarenetwork/flarejs": "5.2.0",
    "@ledgerhq/hw-app-eth": "^7.11.0",
    "@ledgerhq/hw-transport-node-hid": "^6.33.5",
    "@scure/base": "^2.2.0",
    "@zondax/ledger-flare": "^1.2.1",
    "bech32": "^2.0.0",
    "bn.js": "^5.2.1",
    "commander": "^14.0.3",
    "dotenv": "^18.0.8",
    "elliptic": "^6.5.4",
    "ethereumjs-util": "^7.1.5",
    "ethers": "^6.17.0",
    "figlet": "~1.11.3",
    "inquirer": "^8.2.7",
    "web3": "^4.16.0",
    "web3-utils": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.4",
    "@flarenetwork/eslint-config-flare": "^0.0.2",
    "@flarenetwork/prettier-config-flare": "^0.0.3",
    "@types/bn.js": "^5.2.0",
    "@types/chai": "^5.2.3",
    "@types/elliptic": "^6.4.15",
    "@types/figlet": "^1.7.0",
    "@types/inquirer": "^8.2.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "c8": "^10.1.3",
    "chai": "^6.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "mocha": "^12.0.3",
    "node-pty": "^1.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-solidity": "^2.4.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
